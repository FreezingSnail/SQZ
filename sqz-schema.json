{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sqz-payload-v1",
  "title": "SQZPayload",
  "description": "Compressed instruction payload for the SQZ grammar (v1). Clean-room spec; mirrors the SQZ AST shape: mode/target/constraints/verbatim/confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "mode", "target", "constraints", "verbatim", "confidence"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1,
      "description": "Payload schema version."
    },
    "mode": {
      "type": "string",
      "enum": ["refactor", "api", "debug", "docs", "test", "review", "arch", "general"],
      "description": "Task category; selects expand template and validation policy."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "lang"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Files the payload may affect."
        },
        "lang": {
          "type": "string",
          "minLength": 1,
          "description": "Primary language of the target."
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Constraint clause. May contain SQZ symbols (see sqz.ebnf clause rules) or verbatim prose."
      },
      "description": "Invariants the result must satisfy."
    },
    "verbatim": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Raw prose clauses the compressor could not encode. Must be preserved unchanged."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Compressor self-reported probability that intent is preserved."
    }
  }
}